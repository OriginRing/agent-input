{
  "name": "vue-agent-input",
  "version": "0.3.0",
  "description": "A Vue 3 chat composer with fixed, editable, and dropdown tags and customizable suggestions.",
  "license": "MIT",
  "keywords": [
    "vue-agent-input",
    "agent-input",
    "ai-input",
    "input",
    "input-x"
  ],
  "type": "module",
  "files": ["dist", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OriginRing/agent-input"
  },
  "bugs": {
    "url": "https://github.com/OriginRing/agent-input/issues"
  },
  "homepage": "https://github.com/OriginRing/agent-input",
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build --mode library && vue-tsc -p tsconfig.build.json && node scripts/finalize-types.mjs",
    "build:demo": "vite build",
    "test": "playwright test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "less": "^4.2.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
